<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background hijau muda -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#cfebd0"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- Outline kotak hijau di dalam -->
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#2ecc71"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- Garis putus-putus luar -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#2ecc71"
                android:dashWidth="8dp"
                android:dashGap="6dp"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
